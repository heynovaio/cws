# Copy to .env.local and fill in. Never commit real values.
# Production values live in Netlify → Site configuration → Environment variables.

# --- Domains / locale ---
# Locale is chosen by host. For local FR testing use localhost + fr.localhost
# and browse http://fr.localhost:3000
NEXT_PUBLIC_DOMAIN_EN=localhost
NEXT_PUBLIC_DOMAIN_FR=fr.localhost

# --- Prismic ---
# Optional: override the repo name from slicemachine.config.json (e.g. a Prismic environment)
# NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# --- Sitemap ---
# SITE_URL=https://womenandsport.ca/

# --- Mailchimp (newsletter signup at /api/newsletter) ---
MAILCHIMP_API_KEY=
# Data-center prefix, e.g. us12
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DOUBLE_OPT_IN=false
# Merge tag that stores subscriber language, e.g. LANG
MAILCHIMP_LANG_MERGE_TAG=
# Comma-separated merge tags the audience requires, plus a fallback for each
MAILCHIMP_REQUIRED_FIELDS=
# MAILCHIMP_FALLBACK_LNAME=
# MAILCHIMP_FALLBACK_MMERGE4=

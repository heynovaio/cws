{
  "name": "cws",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "start": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "next:dev": "next dev",
    "build": "next build",
    "next:start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "slicemachine": "start-slicemachine",
    "postbuild": "next-sitemap",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.1",
    "@next/third-parties": "^15.4.7",
    "@prismicio/client": "^7.21.8",
    "@prismicio/helpers": "^2.3.9",
    "@prismicio/next": "^1.7.1",
    "@prismicio/react": "^3.4.1",
    "@types/negotiator": "^0.6.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.12.1",
    "fuse.js": "^7.1.0",
    "motion": "^12.12.1",
    "next": "15.4.8",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-headless-pagination": "^1.1.6",
    "react-icons": "^5.4.0",
    "react-intersection-observer": "^9.16.0",
    "react-multi-carousel": "^2.8.6",
    "use-debounce": "^10.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@slicemachine/adapter-next": "^0.3.96",
    "@tanstack/react-query": "^5.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "slice-machine-ui": "^2.21.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}

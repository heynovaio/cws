{
  "name": "cws",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "start": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "next:dev": "next dev",
    "build": "next build",
    "next:start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "slicemachine": "start-slicemachine",
    "postbuild": "next-sitemap",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@next/third-parties": "^15.5.27",
    "@prismicio/client": "^7.22.1",
    "@prismicio/helpers": "^2.3.9",
    "@prismicio/next": "^1.7.1",
    "@prismicio/react": "^3.5.1",
    "@types/negotiator": "^0.6.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "motion": "^12.43.0",
    "next": "15.5.27",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-headless-pagination": "^1.1.6",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^9.16.0",
    "react-multi-carousel": "2.8.5",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@slicemachine/adapter-next": "^0.3.99",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "slice-machine-ui": "^2.21.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": "prettier --write"
  }
}

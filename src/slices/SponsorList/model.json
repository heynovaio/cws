{
  "id": "sponsor_list",
  "type": "SharedSlice",
  "name": "SponsorList",
  "description": "SponsorList",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "cta_text": {
          "type": "Text",
          "config": {
            "label": "CTA Text",
            "placeholder": ""
          }
        },
        "hide_title": {
          "type": "Boolean",
          "config": {
            "label": "Hide Title",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "centre_logo": {
          "type": "Boolean",
          "config": {
            "label": "Centre Logo (if title is hidden)",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "number_of_columns": {
          "type": "Select",
          "config": {
            "label": "Number of Columns",
            "placeholder": "",
            "options": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ]
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "heading2,heading3,heading4"
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Body",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,strong,em,rtl,o-list-item,list-item,embed,image,hyperlink"
          }
        },
        "buttons": {
          "type": "Link",
          "config": {
            "label": "Buttons",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": true
          }
        },
        "sponsors": {
          "type": "Group",
          "config": {
            "label": "Logos",
            "repeat": true,
            "fields": {
              "logo_image": {
                "type": "Image",
                "config": {
                  "label": "Logo Image",
                  "constraint": {
                    "width": null,
                    "height": null
                  },
                  "thumbnails": []
                }
              },
              "logo_link": {
                "type": "Link",
                "config": {
                  "label": "Logo Link",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true,
                  "allowText": true,
                  "repeat": false
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
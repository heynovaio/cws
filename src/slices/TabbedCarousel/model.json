                "type": "StructuredText",
                "config": {
                  "label": "Card Title",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "multi": "heading2,heading3,heading4,heading5,heading6"
                }
              },
              "card_description": {
                "type": "StructuredText",
                "config": {
                  "label": "Card Description",
                  "placeholder": "",
